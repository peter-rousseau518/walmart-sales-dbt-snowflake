# Copy to ~/.dbt/profiles.yml and fill in the three personal values.
# Each target builds into its own environment database; the RAW (bronze) layer
# is read from the same database (see models/staging/_sources.yml).
# STAGING and PROD are normally deployed by GitHub Actions; run them locally
# only in an emergency, as TRANSFORMER, so object ownership stays consistent.
my_project:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: <your_account_identifier>
      user: <your_username>
      password: <your_password>
      role: ACCOUNTADMIN
      warehouse: COMPUTE_WH
      database: WALMART_DEV
      schema: DBT_PETER          # personal development schema
      threads: 4
    staging:
      type: snowflake
      account: <your_account_identifier>
      user: <your_username>
      password: <your_password>
      role: TRANSFORMER       # same least-privilege role CI/CD uses
      warehouse: COMPUTE_WH
      database: WALMART_STAGING
      schema: ANALYTICS
      threads: 4
    prod:
      type: snowflake
      account: <your_account_identifier>
      user: <your_username>
      password: <your_password>
      role: TRANSFORMER       # same least-privilege role CI/CD uses
      warehouse: COMPUTE_WH
      database: WALMART_PROD
      schema: ANALYTICS
      threads: 4
